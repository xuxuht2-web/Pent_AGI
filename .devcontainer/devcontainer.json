{
  "name": "PentAGI Test Lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash .devcontainer/prepare.sh",
  "forwardPorts": [
    8443
  ],
  "portsAttributes": {
    "8443": {
      "label": "PentAGI",
      "onAutoForward": "notify"
    }
  }
}